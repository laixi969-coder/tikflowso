# Select one cloud provider. Requests only use that provider's key.
TIKFLOWSO_VISION_PROVIDER=bailian
DASHSCOPE_API_KEY=
ARK_API_KEY=
OPENROUTER_API_KEY=
ATLASCLOUD_API_KEY=
DEEPSEEK_API_KEY=
TIKFLOWSO_BAILIAN_MODEL=qwen3.7-plus
TIKFLOWSO_VOLCENGINE_MODEL=doubao-seed-2-0-lite-260215
TIKFLOWSO_OPENROUTER_MODEL=qwen/qwen3.7-plus
TIKFLOWSO_ATLAS_MODEL=qwen/qwen3.7-plus
TIKFLOWSO_DEEPSEEK_MODEL=deepseek-flash
# Optional regional endpoints, e.g. TIKFLOWSO_BAILIAN_BASE_URL. Defaults are listed in README.
TIKFLOWSO_CUSTOM_BASE_URL=
TIKFLOWSO_CUSTOM_MODEL=
TIKFLOWSO_VISION_JSON_MODE=0
# For a custom gateway or optional text-generation endpoint:
TIKFLOWSO_MODEL_KEY=
TIKFLOWSO_MODEL_URL=
TIKFLOWSO_MODEL=
# First-party callbacks, read-only API client and billing. Set the deployed origin before enabling Stripe.
TIKFLOWSO_PUBLIC_URL=http://127.0.0.1:8765
TIKFLOWSO_URL=http://127.0.0.1:8765
TIKFLOWSO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
TIKFLOWSO_AFFILIATE_BPS=0
# Local files for licensed feeds, FX and optional notification routing.
TIKFLOWSO_FEEDS=
TIKFLOWSO_FX_RATES=
TIKFLOWSO_ALERT_ROUTES=
MAIL_PASSWORD=
SMS_TOKEN=
TIKFLOWSO_STREAM_SOURCE=
TIKFLOWSO_STREAM_TOKEN=
# Empty uses .data/models/whisper.bin
TIKFLOWSO_WHISPER_MODEL=
